---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site, experience, lessons, toolkit, faqs } from '../data/site';

const facts = [
  { n: '5', l: 'Years building' },
  { n: '6', l: 'Companies shipped at' },
  { n: '12', l: 'Products launched' },
];
---

<Base
  title="About Lakshay Kumar — Generative AI engineer and builder"
  description="Lakshay Kumar builds AI products end to end, from the prompt layer to the interface. Five years in, six companies, a dozen launched products, and the lessons from the ones that failed."
  og="about"
  type="profile"
  jsonLd={[
    { '@type': 'ProfilePage', '@id': `${site.url}/about/#profile`, url: `${site.url}/about/`, mainEntity: { '@id': `${site.url}/#person` } },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ]}
>
  <section class="wrap head">
    <p class="label"><b>01</b> — About</p>
    <h1><span class="mask"><span>About<span class="pop">.</span></span></span></h1>
  </section>

  <section class="wrap">
    <div class="story">
    <div class="story__text">
      <p class="lede">I build AI products <strong>end to end</strong>: the prompt layer, the API, and the interface the user actually sees. Five years in, I’ve shipped at six companies and launched about a dozen products.</p>
      <p>I care about the small moments. A loading state that tells the truth, a prompt that returns the right thing the first time, a page that loads before you notice it. Most of the craft is in the friction you remove.</p>
      <p>When I want to understand something properly, I either build it from scratch or put models side by side and <a href="/writing/" class="link">write up what happens</a>. Right now I’m a generative AI engineer at a fintech startup, and on the side I’m building <a href="https://www.dociq.space/" target="_blank" rel="noopener" class="link">DocIQ</a>, <a href="https://hyd-rent.vercel.app/" target="_blank" rel="noopener" class="link">Hyd/Rent</a> and <a href="/writing/liri-memory-companion/" class="link">Liri</a>, and teaching <a href="/workshops/" class="link">AI agent workshops</a>.</p>
    </div>
    <dl class="story__facts">
      <div><dt class="label">Based in</dt><dd>{site.location} ({site.timezone})</dd></div>
      <div><dt class="label">Works on</dt><dd>LLM systems, agents, RAG, full-stack AI</dd></div>
      <div><dt class="label">Also known as</dt><dd>{site.handle}</dd></div>
      <div><dt class="label">Contact</dt><dd><a href="/talk/" class="link">Talk to me</a><br /><span class="muted small">{site.email}</span></dd></div>
    </dl>
    </div>
  </section>

  <section class="wrap" aria-label="In numbers">
    <dl class="nums">
      {facts.map((f) => <div data-reveal><dd class="display">{f.n}</dd><dt class="label">{f.l}</dt></div>)}
    </dl>
  </section>

  <section class="wrap sect" aria-labelledby="exp">
    <div class="sect__head"><p class="label"><b>02</b> — Experience</p><h2 id="exp">Where I’ve built<span class="pop">.</span></h2></div>
    <ol class="record">
      {experience.map((e, i) => (
        <li data-reveal style={`--i:${i % 3}`}>
          <span class="mono muted num">{e.period}</span>
          <span class="record__org display">{e.org}</span>
          <span>{e.role}{e.note && <span class="muted"> · {e.note}</span>}</span>
          {i === 0 && <span class="label"><span class="dot dot--ok" aria-hidden="true"></span>Current</span>}
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap sect sect--tight" aria-labelledby="lessons">
    <div class="sect__head"><p class="label"><b>03</b> — Experiments</p><h2 id="lessons">Things I tried, and what they taught me<span class="pop">.</span></h2></div>
    <div class="lessons">
      {lessons.map((l, i) => (
        <article class="les" data-reveal style={`--i:${i % 4}`}>
          <p class="label"><b>{String(i + 1).padStart(2, '0')}</b> — Project</p>
          <h3>{l.name}</h3>
          <p class="muted">{l.lesson}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap sect sect--tight" aria-labelledby="kit">
    <div class="sect__head"><p class="label"><b>04</b> — Capabilities</p><h2 id="kit">The toolkit<span class="pop">.</span></h2></div>
    <dl class="kit">
      {toolkit.map((g) => (
        <div><dt class="label">{g.group}</dt><dd>{g.items.join(' · ')}</dd></div>
      ))}
    </dl>
  </section>

  <section class="wrap sect sect--tight" aria-labelledby="faq">
    <div class="sect__head"><p class="label"><b>05</b> — FAQ</p><h2 id="faq">Common questions<span class="pop">.</span></h2></div>
    <div class="faq">
      {faqs.map((f, i) => (
        <details>
          <summary><span class="mono muted num">{String(i + 1).padStart(2, '0')}</span><h3>{f.q}</h3><span class="faq__icon" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="faq__cta"><a href="/talk/" class="btn">Still curious? Talk to me <Arrow /></a></p>
  </section>
</Base>

<style>
  .head { padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 4vw, 3rem); display: grid; gap: 1.5rem; justify-items: start; }
  .head h1 { font-size: clamp(4rem, 19vw, 17rem); line-height: 0.84; letter-spacing: -0.06em; font-weight: 900; font-stretch: 100%; }
  .story { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.7fr); gap: clamp(2rem, 7vw, 6rem); padding-top: 2rem; border-top: 1px solid var(--fg); padding-bottom: clamp(3rem, 6vw, 5rem); }
  @media (max-width: 860px) { .story { grid-template-columns: 1fr; } }
  .story__text { display: grid; gap: 1.25rem; max-width: 42rem; }
  .story__text p:not(.lede) { color: var(--soft); }
  .story__facts { display: grid; gap: 1.5rem; align-content: start; }
  .story__facts dd { margin-top: 0.25rem; }

  .nums { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--fg); }
  .nums > div { display: grid; gap: 0.75rem; padding: clamp(1.25rem, 3vw, 2.25rem) 1.25rem clamp(1.25rem, 3vw, 2.25rem) 0; }
  .nums > div + div { border-left: 1px solid var(--line); padding-left: clamp(1rem, 2.5vw, 1.75rem); }
  .nums dd { margin: 0; font-size: clamp(3.5rem, 11vw, 10rem); font-weight: 900; font-stretch: 100%; letter-spacing: -0.06em; line-height: 0.8; }
  .nums dt { order: 2; }

  .record { list-style: none; padding: 0; border-top: 1px solid var(--fg); }
  .record li { display: grid; grid-template-columns: 10rem minmax(0, 1.2fr) minmax(0, 1fr) 6rem; gap: 0.5rem 1.5rem; align-items: baseline; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .record__org { font-size: clamp(1.5rem, 2.8vw, 2.25rem); letter-spacing: -0.04em; }
  .record .label { justify-self: end; }
  @media (max-width: 760px) { .record li { grid-template-columns: 1fr; } .record .label { justify-self: start; } }

  .lessons { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--fg); }
  .les { display: grid; gap: 0.75rem; align-content: start; padding: 1.5rem 1.5rem 2rem 0; border-bottom: 1px solid var(--line); }
  .les + .les { border-left: 1px solid var(--line); padding-left: 1.5rem; }
  .les h3 { font-size: clamp(1.75rem, 2.6vw, 2.25rem); transition: color 0.25s; }
  .les:hover h3 { color: var(--accent-ink); }
  @media (max-width: 1100px) { .lessons { grid-template-columns: 1fr 1fr; } .les:nth-child(odd) { border-left: 0; padding-left: 0; } }
  @media (max-width: 600px) { .lessons { grid-template-columns: 1fr; } .les, .les + .les { border-left: 0; padding-left: 0; } }

  .kit { display: grid; border-top: 1px solid var(--fg); }
  .kit > div { display: grid; grid-template-columns: 12rem 1fr; gap: 1.5rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .kit dd { font-size: 1.1875rem; color: var(--soft); }
  @media (max-width: 640px) { .kit > div { grid-template-columns: 1fr; gap: 0.375rem; } }

  .faq { border-top: 1px solid var(--fg); max-width: 58rem; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1rem; align-items: center; padding: 1.5rem 0; cursor: pointer; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary h3 { font-size: clamp(1.25rem, 2.2vw, 1.75rem); transition: color 0.25s; }
  .faq summary:hover h3 { color: var(--accent-ink); }
  .faq details p { padding: 0 0 1.75rem 3.5rem; color: var(--soft); max-width: 44rem; }
  .faq__icon { position: relative; width: 1rem; height: 1rem; }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; inset: 50% 0 auto; height: 2px; background: currentColor; transition: transform 0.4s var(--ease); }
  .faq__icon::after { transform: rotate(90deg); }
  .faq details[open] .faq__icon::after { transform: rotate(0); }
  .faq__cta { margin-top: 3rem; }
  @media (max-width: 600px) { .faq summary { grid-template-columns: 1fr auto; } .faq summary .mono { display: none; } .faq details p { padding-left: 0; } }
</style>
