---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import ResultsChart from '../components/ResultsChart.astro';
import PostList from '../components/PostList.astro';
import { site, projects } from '../data/site';
import { sessions } from '../data/workshops';
import { getPosts, postUrl, readingTime } from '../lib/posts';

const posts = await getPosts();
const lead = posts.find((p) => p.id === 'ai-trading-arena') ?? posts[0];
const rest = posts.filter((p) => p.id !== lead.id);
const longDate = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

const nameWords = ['Lakshay', 'Kumar'];
const statement =
  "I build AI products end to end, and I test how language models behave when nobody is steering them. Then I write down what happened, including the parts that didn’t work.".split(' ');
---

<Base
  title="Lakshay Kumar — Generative AI Engineer in Bangalore"
  description={site.description}
  og="home"
  jsonLd={[{ '@type': 'ProfilePage', '@id': `${site.url}/#profile`, url: `${site.url}/`, mainEntity: { '@id': `${site.url}/#person` } }]}
>
  <!-- ░░ Room 1 · Hero: the name is the artwork ░░ -->
  <section class="hero" data-hero>
    <div class="wrap hero__top">
      <span class="label"><span class="dot dot--ok" aria-hidden="true"></span>Open to conversations</span>
      <span class="label">Bangalore, IN · <span data-clock class="num">--:--</span> IST</span>
    </div>

    <div class="wrap hero__main">
      <h1 class="hero__h1" aria-label="Lakshay Kumar, Generative AI Engineer">
        <span class="hero__name" data-kinetic aria-hidden="true">
          {nameWords.map((w, wi) => (
            <Fragment><span class="word">{[...w].map((c, i) => <span class="ch" style={`--i:${i + wi * 7}`}>{c}</span>)}</span>{' '}</Fragment>
          ))}
        </span>{' '}
        <span class="hero__role" aria-hidden="true">Generative AI Engineer <i class="dot" aria-hidden="true"></i> Builder <i class="dot" aria-hidden="true"></i> <span class="mono muted">{site.handle}</span></span>
      </h1>
    </div>

    <div class="wrap hero__bottom">
      <p class="hero__pitch">I build AI products, and test how language models behave when nobody is steering them.</p>
      <a href="#experiments" class="hero__cue"><span>Scroll</span><i aria-hidden="true"></i></a>
    </div>
  </section>

  <!-- ░░ Room 2 · Statement: words light up as you read ░░ -->
  <section class="stmt" aria-label="About">
    <div class="wrap stmt__grid">
      <p class="label stmt__label"><b>01</b> — What I do</p>
      <p class="stmt__text" data-statement style={`--n:${statement.length}`}>
        {statement.map((w, i) => <Fragment><span class="sw" style={`--i:${i}`}>{w}</span>{' '}</Fragment>)}
      </p>
      <p class="stmt__more"><a href="/about/" class="btn btn--ghost btn--sm">More about me <Arrow /></a></p>
    </div>
  </section>

  <!-- ░░ Room 3 · The lead experiment (inverted, full-bleed) ░░ -->
  <section class="inv lead" aria-labelledby="lead-title">
    <div class="wrap">
      <p class="label"><b>02</b> — Latest experiment · {longDate(lead.data.date)}</p>
      <h2 id="lead-title" class="lead__title"><a href={postUrl(lead)}>{lead.data.title}<span class="pop">.</span></a></h2>
      <div class="lead__grid">
        <div class="lead__copy" data-reveal>
          <p class="lede">{lead.data.tldr}</p>
          <a href={postUrl(lead)} class="btn">Read the experiment <Arrow /></a>
          <p class="small muted">{readingTime(lead)} min read · same data and prompts for every model</p>
        </div>
        <div class="lead__chart"><ResultsChart /></div>
      </div>
    </div>
  </section>

  <!-- ░░ Room 4 · The rest, as an index ░░ -->
  <section class="wrap sect" id="experiments" aria-labelledby="writing-h">
    <div class="sect__head sect__head--row">
      <div class="sect__t">
        <p class="label"><b>03</b> — Writing</p>
        <h2 id="writing-h">Thinking out loud<span class="pop">.</span></h2>
      </div>
      <a href="/writing/" class="btn btn--ghost btn--sm">All writing <Arrow /></a>
    </div>
    <PostList posts={rest} />
  </section>

  <!-- ░░ Room 5 · Built: three columns, no boxes ░░ -->
  <section class="wrap built" aria-labelledby="built-h">
    <p class="label"><b>04</b> — Now building</p>
    <h2 id="built-h" class="sr-only">Products in the wild</h2>
    <ul class="built__cols">
      {projects.map((p) => {
        const external = p.url.startsWith('http');
        const beta = p.status === 'Private beta';
        return (
          <li data-reveal>
            <a href={p.url} class="prod" target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
              <span class="label"><span class:list={['dot', { 'dot--ok': !beta }]} aria-hidden="true"></span>{p.status}</span>
              <span class="prod__name display">{p.name}</span>
              <span class="prod__sum">{p.summary}</span>
              <span class="prod__go mono">{external ? 'Visit' : 'Read the story'} <Arrow /></span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- ░░ Room 6 · Workshops: sticky split ░░ -->
  <section class="wrap sect" aria-labelledby="ws-h">
    <div class="ws">
      <div class="ws__intro">
        <p class="label"><b>05</b> — Workshops</p>
        <h2 id="ws-h">Learn by building<span class="pop">.</span></h2>
        <p class="lede">Six hands-on sessions on AI agents, from a first prompt to multi-agent systems, memory and MCP. Colleges, communities and teams invite me to run them.</p>
        <a href="/workshops/" class="btn">See the curriculum <Arrow /></a>
      </div>
      <ol class="ws__list">
        {sessions.map((s) => (
          <li>
            <a href={`/workshops/#${s.slug}`}>
              <span class="mono muted num">{s.n}</span>
              <span class="ws__name">{s.title}</span>
              <span class="mono muted num">{s.hours}h · {s.level}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ░░ Room 7 · Finale ░░ -->
  <section class="inv fin" aria-labelledby="talk-h">
    <div class="wrap">
      <p class="label"><b>06</b> — Contact</p>
      <h2 id="talk-h" class="fin__title"><a href="/talk/">Let’s talk<span class="pop">.</span></a></h2>
      <div class="fin__row">
        <p class="lede">Building something with AI? A rough idea, a model-choice question, a stuck prototype. Tell me about it.</p>
        <div class="fin__links">
          <a href={`mailto:${site.email}`} class="fin__mail link">{site.email}</a>
          <a href="/talk/" class="btn">Open the form <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { min-height: calc(100svh - var(--hdr)); display: grid; grid-template-rows: auto 1fr auto; }
  .hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 2rem; padding-top: 1.25rem; }
  .hero__main { align-self: end; padding-block: clamp(2rem, 5vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .hero__h1 { font: inherit; letter-spacing: normal; line-height: 1.2; }
  .hero__name { display: block; font: 800 var(--t-mega)/0.8 var(--display); letter-spacing: -0.055em; }
  .word { display: block; width: max-content; overflow: hidden; padding: 0 0.06em 0.2em 0; margin: 0 -0.06em -0.2em 0; }
  .ch { display: inline-block; font-variation-settings: 'wght' var(--w, 800), 'wdth' var(--x, 100); }
  .hero__role { display: flex; align-items: center; flex-wrap: wrap; gap: 0.625rem; margin-top: clamp(1.75rem, 3.5vw, 3rem); font: 500 clamp(1rem, 1.5vw, 1.25rem)/1.3 var(--body); letter-spacing: -0.01em; }
  .hero__role .dot { width: 0.3rem; height: 0.3rem; background: var(--muted); }
  .hero__bottom { display: flex; justify-content: space-between; align-items: end; gap: 2rem; padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .hero__pitch { max-width: 24rem; color: var(--soft); font-size: clamp(1rem, 1.3vw, 1.1875rem); line-height: 1.35; }
  .hero__cue { display: inline-flex; align-items: center; gap: 0.875rem; font: 400 0.6875rem/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .hero__cue i { display: block; width: 3.5rem; height: 1px; background: currentColor; transform-origin: left; }
  @media (max-width: 640px) { .hero__bottom { flex-direction: column; align-items: flex-start; gap: 1.25rem; } .hero__cue i { width: 2rem; } }
  @media (prefers-reduced-motion: no-preference) {
    .ch { animation: inflate 1.35s var(--ease-out) backwards; animation-delay: calc(var(--i) * 55ms + 150ms); }
    @keyframes inflate { from { transform: translateY(118%); font-variation-settings: 'wght' 400, 'wdth' 75; } }
    .hero__role, .hero__pitch, .hero__top, .hero__cue { animation: fade-up 1s var(--ease-out) 0.9s backwards; }
    .hero__top { animation-delay: 0.3s; }
    @keyframes fade-up { from { opacity: 0; transform: translateY(12px); } }
    .hero__cue i { animation: cue 2.4s var(--ease-io) 1.6s infinite; }
    @keyframes cue { 0% { transform: scaleX(0); transform-origin: left; } 45% { transform: scaleX(1); transform-origin: left; } 55% { transform: scaleX(1); transform-origin: right; } 100% { transform: scaleX(0); transform-origin: right; } }
  }

  /* Statement: broken grid, words lift from faint to full */
  .stmt { padding-block: clamp(6rem, 15vw, 13rem) clamp(4.5rem, 10vw, 9rem); }
  .stmt__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 2rem; }
  .stmt__label { grid-column: 1 / -1; align-self: start; padding-top: 0.9em; }
  .stmt__text { grid-column: 1 / -1; font: 700 clamp(1.875rem, 5vw, 4.75rem)/1.05 var(--display); font-stretch: 94%; letter-spacing: -0.04em; text-wrap: balance; --p: 1; }
  .stmt__more { grid-column: 1 / -1; }
  @media (min-width: 900px) { .stmt__label { grid-column: 1 / 4; } .stmt__text { grid-column: 4 / -1; } .stmt__more { grid-column: 4 / -1; } }
  .sw { opacity: clamp(0.46, calc(0.46 + (var(--p) * (var(--n) + 3) - var(--i)) * 0.18), 1); }
  :global(.js) .stmt__text { --p: 0; }

  /* Lead */
  .lead { padding-block: clamp(4.5rem, 10vw, 9rem); }
  .lead__title { margin-top: 1.75rem; font-size: clamp(2.75rem, 8vw, 7.75rem); max-width: 16ch; line-height: 0.88; letter-spacing: -0.055em; }
  .lead__title a { transition: color 0.3s; }
  .lead__title a:hover { color: var(--accent); }
  .lead__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2.5rem, 6vw, 6rem); margin-top: clamp(3rem, 6vw, 5.5rem); align-items: start; }
  @media (max-width: 900px) { .lead__grid { grid-template-columns: 1fr; } }
  .lead__copy { display: grid; gap: 1.75rem; justify-items: start; }
  .lead__copy .lede { font-size: clamp(1.1875rem, 1.8vw, 1.5rem); }

  /* Built */
  .built { padding-block: clamp(1rem, 3vw, 2rem) 0; }
  .built > .label { padding-bottom: 1.25rem; }
  .built__cols { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--fg); }
  .built__cols li + li { border-left: 1px solid var(--line); }
  .prod { display: grid; gap: 1rem; align-content: start; height: 100%; padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.25rem, 3vw, 2.5rem) clamp(1.75rem, 3vw, 2.75rem) 0; }
  .built__cols li + li .prod { padding-left: clamp(1.25rem, 3vw, 2.5rem); }
  .prod__name { font-size: clamp(2.75rem, 6.4vw, 6rem); font-weight: 900; font-stretch: 100%; letter-spacing: -0.055em; line-height: 0.85; transition: color 0.3s, letter-spacing 0.6s var(--ease); }
  .prod:hover .prod__name { color: var(--accent); letter-spacing: -0.04em; }
  .prod__sum { color: var(--muted); max-width: 26rem; }
  .prod__go { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.6875rem; }
  .prod__go :global(svg) { width: 0.75rem; height: 0.75rem; transition: transform 0.4s var(--ease); }
  .prod:hover .prod__go :global(svg) { transform: translateX(4px); }
  @media (max-width: 860px) {
    .built__cols { grid-template-columns: 1fr; }
    .built__cols li + li { border-left: 0; border-top: 1px solid var(--line); }
    .built__cols li + li .prod { padding-left: 0; }
    .prod { padding-right: 0; }
  }

  /* Workshops */
  .ws { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2.5rem, 7vw, 6rem); align-items: start; }
  @media (max-width: 900px) { .ws { grid-template-columns: 1fr; } }
  .ws__intro { display: grid; gap: 1.5rem; justify-items: start; position: sticky; top: calc(var(--hdr) + 2rem); }
  @media (max-width: 900px) { .ws__intro { position: static; } }
  .ws__list { list-style: none; padding: 0; border-top: 1px solid var(--fg); }
  .ws__list li { border-bottom: 1px solid var(--line); }
  .ws__list a { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) auto; gap: 1rem; align-items: baseline; padding: 1.25rem 0; transition: padding 0.5s var(--ease); }
  .ws__list a:hover { padding-left: 0.75rem; }
  .ws__name { font: 800 clamp(1.25rem, 2.2vw, 1.75rem)/1.1 var(--display); font-stretch: 94%; letter-spacing: -0.035em; transition: color 0.2s; }
  .ws__list a:hover .ws__name { color: var(--accent-ink); }
  @media (max-width: 520px) { .ws__list a { grid-template-columns: 2rem 1fr; } .ws__list a > :last-child { grid-column: 2; } }

  /* Finale */
  .fin { padding-block: clamp(5rem, 11vw, 10rem) clamp(4rem, 8vw, 7rem); }
  .fin__title { margin-top: 1.5rem; font-size: clamp(4rem, 17vw, 17rem); font-weight: 900; font-stretch: 100%; line-height: 0.82; letter-spacing: -0.06em; }
  .fin__title a { display: inline-block; transition: color 0.3s, transform 0.7s var(--ease); }
  .fin__title a:hover { color: var(--accent); transform: translateX(0.04em); }
  .fin__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem 4rem; align-items: end; margin-top: clamp(2.5rem, 5vw, 4.5rem); padding-top: clamp(1.5rem, 3vw, 2.5rem); border-top: 1px solid var(--line); }
  @media (max-width: 800px) { .fin__row { grid-template-columns: 1fr; } }
  .fin__row .lede { max-width: 30rem; }
  .fin__links { display: grid; gap: 1.25rem; justify-items: start; }
  .fin__mail { font: 700 clamp(1.25rem, 2.6vw, 2rem)/1.1 var(--display); font-stretch: 94%; letter-spacing: -0.03em; }
</style>
