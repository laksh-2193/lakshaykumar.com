---
import Arrow from './Arrow.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/writing/', label: 'Writing' },
  { href: '/workshops/', label: 'Workshops' },
  { href: '/about/', label: 'About' },
];
---

<header class="hdr">
  <div class="hdr__in">
    <a href="/" class="hdr__logo" aria-label="Lakshay Kumar, home"><span class="dot"></span>Lakshay Kumar</a>
    <nav aria-label="Primary" class="hdr__nav">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="/talk/" class="btn btn--ghost btn--sm hdr__cta">Talk to me <Arrow /></a>
  </div>
</header>

<style>
  .hdr { background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); }
  @media (min-width: 761px) { .hdr { position: sticky; top: 0; z-index: 50; } }
  .hdr__in { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding: 1.25rem var(--gutter); max-width: 100%; }
  .hdr__logo { display: inline-flex; align-items: center; gap: 0.625rem; font: 600 1rem/1 var(--body); letter-spacing: -0.01em; justify-self: start; }
  .hdr__nav ul { display: flex; gap: clamp(1.25rem, 3.5vw, 2.5rem); list-style: none; padding: 0; }
  .hdr__nav a { font-size: 0.9375rem; color: var(--muted); transition: color 0.2s; position: relative; padding-block: 0.25rem; }
  .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { color: var(--fg); }
  .hdr__nav a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--accent); }
  .hdr__cta { justify-self: end; }
  @media (max-width: 760px) {
    .hdr__in { grid-template-columns: 1fr auto; padding-block: 1rem; }
    .hdr__nav { grid-column: 1 / -1; grid-row: 2; }
    .hdr__nav ul { gap: 1.5rem; }
  }
</style>
