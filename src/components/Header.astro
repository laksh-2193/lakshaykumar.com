---
const path = Astro.url.pathname;
const links = [
  { href: '/writing/', label: 'Writing' },
  { href: '/workshops/', label: 'Workshops' },
  { href: '/about/', label: 'About' },
];
---

<header class="hdr" data-hdr>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="Lakshay Kumar, home"><span class="dot" aria-hidden="true"></span>Lakshay Kumar</a>

    <button class="hdr__menu" popovertarget="menu" aria-label="Open menu">Menu<span aria-hidden="true"></span></button>

    <nav id="menu" popover class="hdr__nav" aria-label="Primary">
      <button class="hdr__close" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu">Close</button>
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li class="hdr__cta"><a href="/talk/" aria-current={path.startsWith('/talk/') ? 'page' : undefined}>Talk to me</a></li>
      </ul>
      <p class="hdr__foot mono">Bangalore · <span data-clock class="num">--:--</span> IST</p>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 60; view-transition-name: hdr;
    background: color-mix(in oklch, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2);
    transition: transform 0.5s var(--ease-io);
  }
  :global(.hdr.is-hidden) { transform: translateY(-101%); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; height: var(--hdr); }
  .hdr__logo { display: inline-flex; align-items: center; gap: 0.625rem; font: 600 1rem/1 var(--body); letter-spacing: -0.015em; }

  /* Desktop: inline links. */
  .hdr__menu, .hdr__close, .hdr__foot { display: none; }
  .hdr__nav[popover] { display: block; position: static; inset: auto; width: auto; height: auto; margin: 0; padding: 0; border: 0; background: none; color: inherit; overflow: visible; }
  .hdr__nav ul { display: flex; align-items: center; gap: clamp(1.25rem, 3vw, 2.5rem); list-style: none; padding: 0; }
  .hdr__nav a { font-size: 0.9375rem; color: var(--muted); transition: color 0.25s; position: relative; padding-block: 0.375rem; }
  .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { color: var(--fg); }
  .hdr__nav a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--accent); }
  .hdr__cta a { color: var(--fg) !important; border: 1px solid var(--fg); border-radius: 999px; padding: 0.625rem 1.125rem; transition: background-color 0.3s var(--ease), color 0.3s, border-color 0.3s; }
  .hdr__cta a:hover { background: var(--fg); color: var(--bg) !important; }
  .hdr__cta a[aria-current='page']::after { display: none; }

  /* Mobile: a button opens a full-screen menu (native popover, no JS). */
  @media (max-width: 760px) {
    .hdr__menu { display: inline-flex; align-items: center; gap: 0.625rem; font: 500 0.9375rem/1 var(--body); padding: 0.625rem 0; }
    .hdr__menu span { width: 1.125rem; height: 0.5rem; border-block: 2px solid currentColor; }
    .hdr__nav[popover]:not(:popover-open) { display: none; }
    .hdr__nav[popover]:popover-open {
      position: fixed; inset: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center;
      padding: calc(var(--hdr) + 1rem) var(--gutter) 2rem; background: var(--fg); color: var(--bg); overflow-y: auto;
      animation: menu-in 0.5s var(--ease-out);
    }
    .hdr__close { display: block; position: absolute; top: 0; right: var(--gutter); height: var(--hdr); font: 500 0.9375rem/1 var(--body); }
    .hdr__nav ul { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    .hdr__nav a { font: 800 clamp(3rem, 15vw, 5.5rem)/1 var(--display); font-stretch: 94%; letter-spacing: -0.05em; color: var(--bg); padding: 0.1em 0; }
    .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { color: var(--accent); }
    .hdr__nav a[aria-current='page']::after { display: none; }
    .hdr__cta a { border: 0; padding: 0.1em 0; border-radius: 0; color: var(--accent) !important; }
    .hdr__cta a:hover { background: none; }
    .hdr__foot { display: block; margin-top: 2.5rem; color: oklch(0.7 0.01 85); }
  }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-1.5%); } }
</style>
