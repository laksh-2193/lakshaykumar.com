---
import { type Post, postUrl, readingTime } from '../lib/posts';

interface Props {
  posts: Post[];
  headingLevel?: 'h2' | 'h3';
  /** Show the one-line description under each title (writing index). */
  dek?: boolean;
  /** Trail a result chip after the pointer on desktop. */
  chip?: boolean;
}
const { posts, headingLevel = 'h3', dek = false, chip = true } = Astro.props;
const H = headingLevel;
const month = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<ul class="rows" data-chip={chip ? '' : undefined}>
  {posts.map((p, i) => (
    <li data-series={p.data.series}>
      <a href={postUrl(p)} class="row" data-result={p.data.result}>
        <span class="row__n mono num">{String(i + 1).padStart(2, '0')}</span>
        <span class="row__main">
          <H class="row__title">{p.data.title}</H>
          {dek && <span class="row__dek">{p.data.description}</span>}
          <span class="row__sub">{p.data.series} · {readingTime(p)} min read</span>
          <span class="row__result">{p.data.result}</span>
        </span>
        <time class="row__date mono num" datetime={p.data.date.toISOString()}>{month(p.data.date)}</time>
      </a>
    </li>
  ))}
</ul>
