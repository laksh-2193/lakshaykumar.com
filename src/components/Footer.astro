---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr__grid">
      <div>
        <p class="label">Elsewhere</p>
        <ul>
          <li><a href={site.linkedin} rel="me noopener" target="_blank" class="link">LinkedIn</a></li>
          <li><a href={site.github} rel="me noopener" target="_blank" class="link">GitHub</a></li>
          <li><a href={`mailto:${site.email}`} class="link">Email</a></li>
          <li><a href="/rss.xml" class="link">RSS</a></li>
        </ul>
      </div>
      <div>
        <p class="label">Site</p>
        <ul>
          <li><a href="/writing/" class="link">Writing</a></li>
          <li><a href="/workshops/" class="link">Workshops</a></li>
          <li><a href="/about/" class="link">About</a></li>
          <li><a href="/talk/" class="link">Talk to me</a></li>
        </ul>
      </div>
      <div>
        <p class="label">Now</p>
        <p class="ftr__now">Bangalore, <span data-clock class="num">--:--</span> IST</p>
        <p class="small muted">Open to conversations about building with AI.</p>
      </div>
    </div>
  </div>
  <div class="ftr__mark" aria-hidden="true">LAKSHAY</div>
  <div class="wrap ftr__base mono muted">
    <span>© {year} Lakshay Kumar</span>
    <span>Set in Archivo, Space Grotesk, JetBrains Mono</span>
    <a href="#top" class="link">Back to top</a>
  </div>
</footer>

<style>
  .ftr { padding-top: clamp(3.5rem, 7vw, 6rem); overflow: hidden; }
  .ftr__grid { display: grid; grid-template-columns: 1fr 1fr 1.6fr; gap: 2.5rem; }
  .ftr ul { list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: 0.5rem; justify-items: start; }
  .ftr__now { margin-top: 1rem; font: 800 1.5rem/1.1 var(--display); font-stretch: 94%; letter-spacing: -0.03em; }
  .ftr__now + p { margin-top: 0.5rem; max-width: 20rem; }
  .ftr__mark {
    font: 900 clamp(3.25rem, 17.6vw, 28rem)/0.8 var(--display); font-stretch: 100%; letter-spacing: -0.045em; text-align: center; white-space: nowrap;
    color: transparent; -webkit-text-stroke: 1.5px var(--fg); margin-top: clamp(3rem, 7vw, 5rem); user-select: none;
  }
  .ftr__base { position: relative; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 2rem; padding-block: 1.25rem 1.5rem; }
  .ftr__base::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 1px; background: var(--line); }
  @media (max-width: 640px) { .ftr__grid { grid-template-columns: 1fr 1fr; } .ftr__grid > div:last-child { grid-column: 1 / -1; } .ftr__base span:nth-child(2) { display: none; } }
</style>
