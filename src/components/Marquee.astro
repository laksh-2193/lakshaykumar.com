---
// Real results from the experiments, set big. Static under reduced motion.
const items = [
  'Claude +5.26%',
  'DeepSeek +4.98%',
  'Gemma 0.00%',
  'GPT −0.23%',
  '4 guilty, 1 free',
  'Zero libraries',
  'Pure NumPy',
  'Claude comeback',
];
---

<div class="mq" aria-label="Experiment results" role="group">
  <div class="mq__track" data-mq>
    <div class="mq__group">
      {items.map((t, i) => (
        <span class:list={['mq__item', { 'is-out': i % 2 === 1 }]}>{t}<i class="dot" /></span>
      ))}
    </div>
  </div>
</div>

<script>
  // The text is in the HTML once. The duplicate that makes the loop seamless is
  // added here, so crawlers and screen readers don't read every result twice.
  document.querySelectorAll<HTMLElement>('[data-mq]').forEach((track) => {
    const group = track.firstElementChild;
    if (!group) return;
    const copy = group.cloneNode(true) as HTMLElement;
    copy.setAttribute('aria-hidden', 'true');
    track.append(copy);
    track.closest('.mq')?.classList.add('is-live');
  });
</script>

<style>
  .mq { overflow: hidden; border-block: 1px solid var(--line); padding-block: clamp(1rem, 2.4vw, 1.75rem); }
  .mq__track { display: flex; width: max-content; }
  .mq__group { display: flex; flex: none; }
  .mq__item { display: inline-flex; align-items: center; gap: clamp(1.5rem, 3vw, 3rem); padding-right: clamp(1.5rem, 3vw, 3rem); font: 800 clamp(2rem, 5vw, 4.5rem)/1 var(--display); letter-spacing: -0.04em; white-space: nowrap; }
  .mq__item.is-out { color: transparent; -webkit-text-stroke: 1.5px var(--fg); }
  .mq__item .dot { width: 0.625rem; height: 0.625rem; }
  @media (prefers-reduced-motion: no-preference) {
    .mq.is-live .mq__track { animation: mq 60s linear infinite; }
    .mq.is-live:hover .mq__track { animation-play-state: paused; }
    @keyframes mq { to { transform: translateX(-50%); } }
  }
</style>
