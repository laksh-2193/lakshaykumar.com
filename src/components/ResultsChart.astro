---
// Annotated bar chart of the trading experiment. Plain HTML/CSS: accessible,
// selectable, and it scales down without the text shrinking. Inherits colours
// from its container, so it works on light and inverted backgrounds.
import { arena } from '../data/models';

const MIN = -0.6;
const MAX = 5.6;
const span = MAX - MIN;
const zero = ((0 - MIN) / span) * 100;
const bar = (ret: number) => {
  if (ret === 0) return { left: zero - 0.25, width: 0.5 };
  if (ret > 0) return { left: zero, width: (ret / span) * 100 };
  return { left: ((ret - MIN) / span) * 100, width: (Math.abs(ret) / span) * 100 };
};
const fmt = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '') + Math.abs(n).toFixed(2) + '%';
---

<figure class="chart" data-reveal style={`--zero:${zero}%`}>
  <figcaption class="chart__head">
    <span class="label">Return after 20 rounds</span>
    <span class="chart__sub">Each model started with $10,000</span>
  </figcaption>

  <ol class="chart__rows">
    {arena.map((a, i) => {
      const b = bar(a.ret);
      return (
        <li class:list={['row', { 'row--lead': i === 0 }]} style={`--i:${i}`}>
          <div class="row__who">
            <span class="row__model">{a.model}</span>
            <span class="row__final num">${a.final.toLocaleString('en-US')}</span>
          </div>
          <div class="row__plot" aria-hidden="true">
            <span class:list={['row__bar', { neg: a.ret < 0 }]} style={`left:${b.left}%;width:${b.width}%`} />
          </div>
          <div class="row__val num">{fmt(a.ret)}</div>
          <p class="row__note">{a.note}</p>
        </li>
      );
    })}
  </ol>
</figure>

<style>
  .chart { margin: 0; }
  .chart__head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.25rem 1rem; padding-bottom: 0.875rem; border-bottom: 1px solid var(--fg); }
  .chart__sub { font: 400 0.75rem/1.4 var(--mono); letter-spacing: 0.04em; color: var(--muted); }
  .chart__rows { list-style: none; padding: 0; }
  .row {
    display: grid; grid-template-columns: minmax(8.5rem, 12rem) minmax(0, 1fr) 5rem; column-gap: 1.25rem; row-gap: 0.25rem;
    align-items: center; padding-block: 1.125rem; border-bottom: 1px solid var(--line);
  }
  .row__who { display: grid; line-height: 1.25; }
  .row__model { font: 700 1.0625rem/1.2 var(--body); letter-spacing: -0.01em; }
  .row__final { font: 400 0.75rem/1.4 var(--mono); color: var(--muted); }
  .row__plot { position: relative; height: 1.5rem; }
  .row__plot::before { content: ''; position: absolute; top: -0.375rem; bottom: -0.375rem; left: var(--zero); width: 1px; background: var(--fg); opacity: 0.35; }
  .row__bar { position: absolute; top: 0; bottom: 0; background: var(--fg); transform-origin: left center; }
  .row__bar.neg { transform-origin: right center; background: var(--muted); }
  .row--lead .row__bar { background: var(--accent); }
  .row__val { text-align: right; font: 800 1.375rem/1 var(--display); letter-spacing: -0.03em; }
  .row--lead .row__val { color: var(--accent); }
  .row__note { grid-column: 2 / -1; font-size: 0.9375rem; line-height: 1.4; color: var(--muted); margin-top: 0.125rem; }

  @media (prefers-reduced-motion: no-preference) {
    .js .chart .row__bar { transform: scaleX(0); transition: transform 1.1s var(--ease); transition-delay: calc(0.3s + var(--i) * 0.12s); }
    .js .chart.is-in .row__bar { transform: none; }
  }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr auto; }
    .row__plot { grid-column: 1 / -1; grid-row: 2; margin-block: 0.375rem; }
    .row__val { grid-row: 1; grid-column: 2; }
    .row__note { grid-column: 1 / -1; }
  }
</style>
